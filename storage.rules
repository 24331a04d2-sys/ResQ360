rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /incidentEvidence/{incidentId}/{fileName} {
      // Allow read to authorized staff or anyone tracking their incident with link
      allow read: if true;
      // Allow upload if image under 5MB
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
